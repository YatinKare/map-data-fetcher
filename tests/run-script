#!/usr/bin/env bash
set -euo pipefail

# Run from any directory. The application is built before this script so build
# time is not included in the startup measurement.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
RUNS_DIR="$REPO_ROOT/runs/baseline"
LOCAL_BIN="/home/yatink/.local/bin"
LOCAL_JDK="/home/yatink/.local/jdk-17/usr/lib/jvm/java-17-openjdk-amd64"
JAVA_BIN="${JAVA_BIN:-$LOCAL_BIN/java}"
CHROMEDRIVER_BIN="${CHROMEDRIVER_BIN:-$LOCAL_BIN/chromedriver}"
PORT="${PORT:-8080}"
GATEWAY_PORT="${GATEWAY_PORT:-3000}"
GATEWAY_AUTH_TOKEN="${GATEWAY_AUTH_TOKEN:-new-token123}"
QUERY="${1:-노원역 맛집}"
COORDINATE_QUERY="${COORDINATE_QUERY:-카페}"
COORDINATE_X="${COORDINATE_X:-127.105649}"
COORDINATE_Y="${COORDINATE_Y:-37.64349}"
JAR_PATH="${2:-}"
GATEWAY_BIN="${GATEWAY_BIN:-$REPO_ROOT/build/baseline/map-data-gateway}"
READY_TIMEOUT_SECONDS="${READY_TIMEOUT_SECONDS:-60}"
REQUEST_TIMEOUT_SECONDS="${REQUEST_TIMEOUT_SECONDS:-120}"
GATEWAY_JAVA_IDLE_TIMEOUT="${GATEWAY_JAVA_IDLE_TIMEOUT:-5s}"
IDLE_WAIT_SECONDS="${IDLE_WAIT_SECONDS:-10}"
MCP_PROTOCOL_VERSION="${MCP_PROTOCOL_VERSION:-2025-11-25}"
MCP_URL="${MCP_URL:-http://127.0.0.1:$GATEWAY_PORT/mcp}"

export JAVA_HOME="${JAVA_HOME:-$LOCAL_JDK}"
export PATH="$(dirname -- "$JAVA_BIN"):$LOCAL_BIN:$PATH"

GATEWAY_PID=""
WORK_DIR=""
REQUEST_PID=""

now_ms() {
  date +%s%N | cut -c1-13
}

utc_timestamp() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

die() {
  printf 'baseline: %s\n' "$1" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

resolve_jar() {
  if [[ -n "$JAR_PATH" ]]; then
    [[ -f "$JAR_PATH" ]] || die "JAR not found: $JAR_PATH"
    printf '%s\n' "$(cd -- "$(dirname -- "$JAR_PATH")" && pwd -P)/$(basename -- "$JAR_PATH")"
    return
  fi

  local candidate
  candidate="$(find "$REPO_ROOT/build/libs" -maxdepth 1 -type f -name '*.jar' ! -name '*-plain.jar' -print -quit 2>/dev/null || true)"
  [[ -n "$candidate" ]] || die "no application JAR found; run ./gradlew clean bootJar -x test first"
  printf '%s\n' "$candidate"
}

resolve_gateway() {
  [[ -x "$GATEWAY_BIN" ]] || die "gateway binary not found or not executable: $GATEWAY_BIN; run tests/build-baseline first"
  printf '%s\n' "$(cd -- "$(dirname -- "$GATEWAY_BIN")" && pwd -P)/$(basename -- "$GATEWAY_BIN")"
}

system_snapshot() {
  local memory_line total used available load process_count cpu_count
  memory_line="$(free -b | awk '/^Mem:/ {print $2, $3, $7}')"
  read -r total used available <<< "$memory_line"
  load="$(awk '{print $1}' /proc/loadavg)"
  process_count="$(ps -e --no-headers | wc -l | tr -d ' ')"
  cpu_count="$(nproc)"

  jq -cn \
    --argjson total "${total:-0}" \
    --argjson used "${used:-0}" \
    --argjson available "${available:-0}" \
    --argjson process_count "${process_count:-0}" \
    --argjson cpu_count "${cpu_count:-0}" \
    --arg load "${load:-0}" \
    '{memory_total_bytes:$total,memory_used_bytes:$used,memory_available_bytes:$available,load_average_1m:($load|tonumber),process_count:$process_count,cpu_count:$cpu_count}'
}

descendant_pids() {
  local root_pid="$1"
  ps -eo pid=,ppid= | awk -v root="$root_pid" '
    { children[$2] = children[$2] " " $1 }
    function visit(pid,   count, i, child, values) {
      if (seen[pid]++) return
      print pid
      count = split(children[pid], values, " ")
      for (i = 1; i <= count; i++) {
        child = values[i]
        if (child != "") visit(child)
      }
    }
    END { visit(root) }
  '
}

process_snapshot() {
  local root_pid="${1:-}"
  if [[ -z "$root_pid" || ! -d "/proc/$root_pid" ]]; then
    jq -cn '{java:{process_count:0,rss_bytes:0,cpu_percent:0,thread_count:0},chrome:{process_count:0,rss_bytes:0,cpu_percent:0,thread_count:0}}'
    return
  fi

  local pids rows
  local java_count java_rss java_cpu java_threads
  local chrome_count chrome_rss chrome_cpu chrome_threads
  pids="$(descendant_pids "$root_pid")"
  rows="$(ps -eo pid=,comm=,rss=,%cpu=,nlwp= | awk -v ids="$pids" '
    BEGIN { count = split(ids, wanted, " "); for (i = 1; i <= count; i++) keep[wanted[i]] = 1 }
    keep[$1] { print }
  ')"

  IFS='|' read -r java_count java_rss java_cpu java_threads chrome_count chrome_rss chrome_cpu chrome_threads <<< "$(printf '%s\n' "$rows" | awk '
    $2 ~ /java/ { java_count++; java_rss += $3; java_cpu += $4; java_threads += $5 }
    $2 ~ /chrome|chromedriver/ { chrome_count++; chrome_rss += $3; chrome_cpu += $4; chrome_threads += $5 }
    END { printf "%d|%d|%.2f|%d|%d|%d|%.2f|%d\n", java_count+0, java_rss+0, java_cpu+0, java_threads+0, chrome_count+0, chrome_rss+0, chrome_cpu+0, chrome_threads+0 }
  '
  )"

  jq -cn \
    --argjson java_count "${java_count:-0}" \
    --argjson java_rss "${java_rss:-0}" \
    --argjson java_cpu "${java_cpu:-0}" \
    --argjson java_threads "${java_threads:-0}" \
    --argjson chrome_count "${chrome_count:-0}" \
    --argjson chrome_rss "${chrome_rss:-0}" \
    --argjson chrome_cpu "${chrome_cpu:-0}" \
    --argjson chrome_threads "${chrome_threads:-0}" \
    '{java:{process_count:$java_count,rss_bytes:($java_rss*1024),cpu_percent:$java_cpu,thread_count:$java_threads},chrome:{process_count:$chrome_count,rss_bytes:($chrome_rss*1024),cpu_percent:$chrome_cpu,thread_count:$chrome_threads}}'
}

gateway_snapshot() {
  local root_pid="${1:-}"
  if [[ -z "$root_pid" || ! -d "/proc/$root_pid" ]]; then
    jq -cn '{process_count:0,rss_bytes:0,cpu_percent:0,thread_count:0}'
    return
  fi

  local row
  row="$(ps -p "$root_pid" -o rss=,%cpu=,nlwp= 2>/dev/null || true)"
  local rss cpu threads
  read -r rss cpu threads <<< "$row"

  jq -cn \
    --argjson rss "${rss:-0}" \
    --arg cpu "${cpu:-0}" \
    --argjson threads "${threads:-0}" \
    '{process_count:1,rss_bytes:($rss*1024),cpu_percent:($cpu|tonumber),thread_count:$threads}'
}

snapshot() {
  local label="$1"
  local system process gateway
  system="$(system_snapshot)"
  process="$(process_snapshot "$GATEWAY_PID")"
  gateway="$(gateway_snapshot "$GATEWAY_PID")"
  jq -cn --arg label "$label" --argjson system "$system" --argjson process "$process" \
    --argjson gateway "$gateway" \
    '{label:$label,system:$system,processes:{java:$process.java,chrome:$process.chrome,gateway:$gateway}}'
}

sample() {
  local offset_ms="$1"
  local system process gateway
  system="$(system_snapshot)"
  process="$(process_snapshot "$GATEWAY_PID")"
  gateway="$(gateway_snapshot "$GATEWAY_PID")"
  jq -cn --arg timestamp "$(utc_timestamp)" --argjson offset_ms "$offset_ms" \
    --argjson system "$system" --argjson process "$process" --argjson gateway "$gateway" \
    '{timestamp_utc:$timestamp,offset_ms:$offset_ms,system:$system,processes:{java:$process.java,chrome:$process.chrome,gateway:$gateway}}'
}

wait_until_ready() {
  local url="$1"
  local pid="$2"
  local started="$3"
  local deadline=$((started + READY_TIMEOUT_SECONDS * 1000))
  local now
  while kill -0 "$pid" 2>/dev/null && (( $(now_ms) < deadline )); do
    if curl -fsS --connect-timeout 1 --max-time 2 -o /dev/null "$url" 2>/dev/null; then
      now="$(now_ms)"
      printf '%s\n' "$((now - started))"
      return 0
    fi
    sleep 0.2
  done
  return 1
}

stop_pid() {
  local root_pid="$1"
  [[ -z "$root_pid" ]] && return 0
  local descendants pid
  descendants="$(descendant_pids "$root_pid" 2>/dev/null || true)"
  kill -TERM "$root_pid" 2>/dev/null || true
  wait "$root_pid" 2>/dev/null || true
  while read -r pid; do
    [[ -z "$pid" || "$pid" == "$root_pid" ]] && continue
    kill -TERM "$pid" 2>/dev/null || true
  done <<< "$descendants"
}

stop_gateway() {
  stop_pid "$GATEWAY_PID"
  GATEWAY_PID=""
}

cleanup() {
  stop_gateway
  if [[ -n "$WORK_DIR" && -d "$WORK_DIR" ]]; then
    rm -rf -- "$WORK_DIR"
  fi
}

wait_for_worker_exit() {
  local deadline now process
  deadline=$(( $(now_ms) + IDLE_WAIT_SECONDS * 1000 ))
  while (( $(now_ms) < deadline )); do
    process="$(process_snapshot "$GATEWAY_PID")"
    if jq -e '.java.process_count == 0 and .chrome.process_count == 0' >/dev/null <<< "$process"; then
      return 0
    fi
    sleep 0.2
  done
  return 1
}

post_mcp_json() {
  local request_file="$1"
  local response_file="$2"
  local write_format='%{http_code}'
  if [[ "${3:-}" == "timed" ]]; then
    write_format='%{http_code}|%{time_total}'
  fi
  curl --silent --show-error \
    --connect-timeout 5 --max-time "$REQUEST_TIMEOUT_SECONDS" \
    -X POST \
    -H "Authorization: Bearer $GATEWAY_AUTH_TOKEN" \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' \
    --data-binary "@$request_file" \
    -o "$response_file" -w "$write_format" \
    "$MCP_URL"
}

validate_mcp_tool_response() {
  local response_file="$1"
  local raw_file="$2"
  jq -e '
    .jsonrpc == "2.0" and
    (.error? | not) and
    (.result.isError != true) and
    (.result.content | length > 0) and
    (.result.content[0].type == "text")
  ' "$response_file" >/dev/null
  jq -er '.result.content[0].text' "$response_file" > "$raw_file"
  jq empty "$raw_file" >/dev/null
}

main() {
  require_command jq
  require_command curl
  require_command free
  require_command ps
  [[ -x "$JAVA_BIN" ]] || die "Java binary not found: $JAVA_BIN"
  [[ -x "$CHROMEDRIVER_BIN" ]] || die "ChromeDriver binary not found: $CHROMEDRIVER_BIN"
  [[ -x /usr/bin/google-chrome ]] || die "Google Chrome not found at /usr/bin/google-chrome"

  local java_version chrome_version driver_version
  java_version="$($JAVA_BIN -version 2>&1 | awk '/version/ {print; exit}')"
  chrome_version="$(/usr/bin/google-chrome --version | awk '{print $3}')"
  driver_version="$($CHROMEDRIVER_BIN --version | awk '{print $2}')"
  [[ "$java_version" == *'17.'* ]] || die "Java 17 is required: $java_version"
  [[ "${chrome_version%%.*}" == "${driver_version%%.*}" ]] || die "Chrome/ChromeDriver major versions differ: $chrome_version vs $driver_version"

  local jar_path jar_name output_file started ready_ms request_started request_exit
  local http_code total_seconds samples request_meta run_status response_file
  local response_bytes response_valid_json response_json_type response_result_count
  local mcp_init_request mcp_init_response mcp_tools_request mcp_tools_response
  local mcp_notification_request mcp_request_file mcp_raw_file mcp_http_code
  local restart_request_file restart_raw_file
  jar_path="$(resolve_jar)"
  gateway_bin="$(resolve_gateway)"
  jar_name="$(basename -- "$jar_path")"
  output_file="$RUNS_DIR/$(date -u +%Y%m%dT%H%M%SZ).json"
  mkdir -p "$REPO_ROOT/artifacts"
  WORK_DIR="$(mktemp -d "$REPO_ROOT/artifacts/.baseline.XXXXXX")"
  response_file="$WORK_DIR/response.json"
  trap cleanup EXIT INT TERM

  mkdir -p "$RUNS_DIR"
  printf '%s\n' "Java: $($JAVA_BIN -version 2>&1 | head -n 1)"
  printf '%s\n' "Chrome: $(/usr/bin/google-chrome --version)"
  printf '%s\n' "ChromeDriver: $($CHROMEDRIVER_BIN --version)"

  local before_snapshot
  before_snapshot="$(snapshot before_start)"

  started="$(now_ms)"
  gateway_started="$started"
  GATEWAY_HOST=127.0.0.1 \
    GATEWAY_PORT="$GATEWAY_PORT" \
    GATEWAY_AUTH_TOKEN="$GATEWAY_AUTH_TOKEN" \
    GATEWAY_JAVA_BASE_URL="http://127.0.0.1:$PORT" \
    GATEWAY_JAVA_BIN="$JAVA_BIN" \
    GATEWAY_JAVA_JAR="$jar_path" \
    GATEWAY_JAVA_CHROMEDRIVER="$CHROMEDRIVER_BIN" \
    GATEWAY_JAVA_HEADLESS=true \
    GATEWAY_JAVA_IDLE_TIMEOUT="$GATEWAY_JAVA_IDLE_TIMEOUT" \
    "$gateway_bin" \
    >"$WORK_DIR/gateway.log" 2>&1 &
  GATEWAY_PID=$!
  gateway_ready_ms="$(wait_until_ready "http://127.0.0.1:$GATEWAY_PORT/healthz" "$GATEWAY_PID" "$gateway_started" || true)"
  [[ -n "$gateway_ready_ms" ]] || die "gateway did not become ready within ${READY_TIMEOUT_SECONDS}s"

  mcp_init_request="$WORK_DIR/mcp-initialize.json"
  mcp_init_response="$WORK_DIR/mcp-initialize-response.json"
  jq -cn --arg protocol "$MCP_PROTOCOL_VERSION" \
    '{jsonrpc:"2.0",id:1,method:"initialize",params:{protocolVersion:$protocol,capabilities:{},clientInfo:{name:"map-data-fetcher-run-script",version:"1"}}}' \
    > "$mcp_init_request"
  mcp_http_code="$(post_mcp_json "$mcp_init_request" "$mcp_init_response")"
  [[ "$mcp_http_code" == "200" ]] || die "MCP initialize failed: HTTP $mcp_http_code"
  jq -e '.result.protocolVersion' "$mcp_init_response" >/dev/null \
    || die "MCP initialize response did not contain a protocol version"

  mcp_notification_request="$WORK_DIR/mcp-initialized.json"
  jq -cn '{jsonrpc:"2.0",method:"notifications/initialized",params:{}}' \
    > "$mcp_notification_request"
  mcp_http_code="$(post_mcp_json "$mcp_notification_request" "$WORK_DIR/mcp-initialized-response.json")"
  [[ "$mcp_http_code" == "200" || "$mcp_http_code" == "202" || "$mcp_http_code" == "204" ]] \
    || die "MCP initialized notification failed: HTTP $mcp_http_code"

  mcp_tools_request="$WORK_DIR/mcp-tools-list.json"
  mcp_tools_response="$WORK_DIR/mcp-tools-list-response.json"
  jq -cn '{jsonrpc:"2.0",id:2,method:"tools/list",params:{}}' > "$mcp_tools_request"
  mcp_http_code="$(post_mcp_json "$mcp_tools_request" "$mcp_tools_response")"
  [[ "$mcp_http_code" == "200" ]] || die "MCP tools/list failed: HTTP $mcp_http_code"
  jq -e '
    (.result.tools | map(.name) | index("naver_map_search") != null) and
    (.result.tools | map(.name) | index("naver_map_coordinate_search") != null)
  ' "$mcp_tools_response" >/dev/null \
    || die "MCP tools/list did not expose both Naver search tools"

  ready_ms="$(( $(now_ms) - started ))"
  java_ready_ms=0

  local ready_snapshot
  ready_snapshot="$(snapshot ready_idle)"
  samples='[]'
  request_started="$(now_ms)"
  mcp_request_file="$WORK_DIR/mcp-search-request.json"
  mcp_raw_file="$WORK_DIR/mcp-search-raw.json"
  jq -cn --arg query "$QUERY" \
    '{jsonrpc:"2.0",id:3,method:"tools/call",params:{name:"naver_map_search",arguments:{query:$query,page:1}}}' \
    > "$mcp_request_file"
  post_mcp_json "$mcp_request_file" "$response_file" timed >"$WORK_DIR/request-meta" 2>"$WORK_DIR/request-error" &
  REQUEST_PID=$!

  while kill -0 "$REQUEST_PID" 2>/dev/null; do
    request_state="$(ps -o stat= -p "$REQUEST_PID" 2>/dev/null || true)"
    [[ "$request_state" == Z* ]] && break
    samples="$(jq -c --argjson item "$(sample "$(($(now_ms) - request_started))")" '. + [$item]' <<< "$samples")"
    sleep 1
  done
  request_exit=0
  wait "$REQUEST_PID" || request_exit=$?
  REQUEST_PID=""
  samples="$(jq -c --argjson item "$(sample "$(($(now_ms) - request_started))")" '. + [$item]' <<< "$samples")"
  request_meta="$(cat "$WORK_DIR/request-meta" 2>/dev/null || true)"
  IFS='|' read -r http_code total_seconds <<< "$request_meta"
  [[ -n "${http_code:-}" ]] || http_code=000
  [[ -n "${total_seconds:-}" ]] || total_seconds=null
  response_bytes="$(wc -c < "$response_file" 2>/dev/null || printf '0')"
  response_valid_json=false
  response_json_type="invalid"
  response_result_count=0
  if validate_mcp_tool_response "$response_file" "$mcp_raw_file" >/dev/null 2>&1; then
    response_valid_json=true
    response_json_type="$(jq -r 'type' "$mcp_raw_file")"
    response_result_count="$(jq -r 'if type == "array" then length else 0 end' "$mcp_raw_file")"
  fi
  run_status="failed"
  if [[ "$request_exit" -eq 0 && "$http_code" == "200" && "$response_valid_json" == true && "$response_json_type" == "array" ]]; then
    run_status="passed"
  fi

  local after_request_snapshot after_idle_shutdown_snapshot after_restart_snapshot
  local after_restart_idle_shutdown_snapshot after_shutdown_snapshot restart_response_file
  local restart_http_code coordinate_http_code finished
  after_request_snapshot="$(snapshot after_request_idle)"
  wait_for_worker_exit || die "Java worker did not stop within ${IDLE_WAIT_SECONDS}s"
  after_idle_shutdown_snapshot="$(snapshot after_idle_shutdown)"

  restart_response_file="$WORK_DIR/restart-response.json"
  restart_request_file="$WORK_DIR/mcp-restart-request.json"
  restart_raw_file="$WORK_DIR/mcp-restart-raw.json"
  jq -cn --arg query "$QUERY" \
    '{jsonrpc:"2.0",id:4,method:"tools/call",params:{name:"naver_map_search",arguments:{query:$query,page:1}}}' \
    > "$restart_request_file"
  restart_http_code="$(post_mcp_json "$restart_request_file" "$restart_response_file" \
    2>"$WORK_DIR/restart-error" || true)"
  [[ "$restart_http_code" == "200" ]] || die "worker did not restart for a second MCP request: HTTP $restart_http_code"
  validate_mcp_tool_response "$restart_response_file" "$restart_raw_file" \
    || die "second MCP request did not return valid raw JSON"
  after_restart_snapshot="$(snapshot after_restart)"
  wait_for_worker_exit || die "restarted Java worker did not stop within ${IDLE_WAIT_SECONDS}s"
  after_restart_idle_shutdown_snapshot="$(snapshot after_restart_idle_shutdown)"

  coordinate_response_file="$WORK_DIR/mcp-coordinate-response.json"
  coordinate_request_file="$WORK_DIR/mcp-coordinate-request.json"
  coordinate_raw_file="$WORK_DIR/mcp-coordinate-raw.json"
  jq -cn --arg query "$COORDINATE_QUERY" --argjson x "$COORDINATE_X" --argjson y "$COORDINATE_Y" \
    '{jsonrpc:"2.0",id:5,method:"tools/call",params:{name:"naver_map_coordinate_search",arguments:{query:$query,x:$x,y:$y,page:1}}}' \
    > "$coordinate_request_file"
  coordinate_http_code="$(post_mcp_json "$coordinate_request_file" "$coordinate_response_file" || true)"
  [[ "$coordinate_http_code" == "200" ]] || die "coordinate MCP request failed: HTTP $coordinate_http_code"
  validate_mcp_tool_response "$coordinate_response_file" "$coordinate_raw_file" \
    || die "coordinate MCP request did not return valid raw JSON"

  stop_gateway
  after_shutdown_snapshot="$(snapshot after_shutdown)"
  finished="$(now_ms)"

  jq -n \
    --arg schema_version '1' \
    --arg timestamp "$(utc_timestamp)" \
    --arg jar "$jar_name" \
    --arg query "$QUERY" \
    --argjson port "$PORT" \
    --argjson gateway_port "$GATEWAY_PORT" \
    --argjson startup_ms "$ready_ms" \
    --argjson gateway_startup_ms "$gateway_ready_ms" \
    --argjson java_startup_ms "$java_ready_ms" \
    --argjson request_exit "$request_exit" \
    --argjson response_bytes "$response_bytes" \
    --argjson response_valid_json "$response_valid_json" \
    --arg response_json_type "$response_json_type" \
    --argjson response_result_count "$response_result_count" \
    --argjson restart_http_status "$restart_http_code" \
    --arg http_code "$http_code" \
    --arg total_seconds "$total_seconds" \
    --arg run_status "$run_status" \
    --argjson total_run_ms "$((finished - started))" \
    --argjson before "$before_snapshot" \
    --argjson ready "$ready_snapshot" \
    --argjson after_request "$after_request_snapshot" \
    --argjson after_idle_shutdown "$after_idle_shutdown_snapshot" \
    --argjson after_restart "$after_restart_snapshot" \
    --argjson after_restart_idle_shutdown "$after_restart_idle_shutdown_snapshot" \
    --argjson after_shutdown "$after_shutdown_snapshot" \
    --argjson samples "$samples" \
    '{schema_version:($schema_version|tonumber),captured_at_utc:$timestamp,status:$run_status,application:{jar:$jar,port:$port,gateway_port:$gateway_port,headless:true},request:{type:"mcp_naver_keyword_search",query:$query,page:1,http_status:($http_code|tonumber),curl_time_seconds:(if $total_seconds == "null" then null else ($total_seconds|tonumber) end),exit_code:$request_exit,response_bytes:$response_bytes,response_valid_json:$response_valid_json,response_json_type:$response_json_type,response_result_count:$response_result_count},restart:{http_status:($restart_http_status|tonumber)},timing:{startup_ms:$startup_ms,gateway_startup_ms:$gateway_startup_ms,java_startup_ms:$java_startup_ms,total_run_ms:$total_run_ms},snapshots:{before_start:$before,ready_idle:$ready,after_request_idle:$after_request,after_idle_shutdown:$after_idle_shutdown,after_restart:$after_restart,after_restart_idle_shutdown:$after_restart_idle_shutdown,after_shutdown:$after_shutdown},request_samples:$samples}' > "$output_file"

  printf '%s\n' "Wrote $output_file"
  [[ "$run_status" == "passed" ]]
}

main "$@"
