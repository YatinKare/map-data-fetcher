[Unit]
Description=Map Data Fetcher Streamable HTTP MCP server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/map-data-fetcher/gateway.env
Environment=GATEWAY_HOST=127.0.0.1
Environment=GATEWAY_PORT=3000
Environment=GATEWAY_JAVA_BASE_URL=http://127.0.0.1:8080
Environment=GATEWAY_JAVA_BIN=%h/.local/bin/java
Environment=GATEWAY_JAVA_JAR=%h/.local/share/map-data-fetcher/map-data-fetcher.jar
Environment=GATEWAY_JAVA_CHROMEDRIVER=%h/.local/bin/chromedriver
Environment=GATEWAY_JAVA_HEADLESS=true
Environment=GATEWAY_JAVA_IDLE_TIMEOUT=5m
Environment=GATEWAY_JAVA_STARTUP_TIMEOUT=90s
Environment=GATEWAY_JAVA_SHUTDOWN_TIMEOUT=15s
Environment=GATEWAY_SERVICE_NAME=map-data-gateway
Environment=GATEWAY_VERSION=0.1.0
Environment=GATEWAY_SHUTDOWN_TIMEOUT=5s
ExecStart=%h/.local/libexec/map-data-fetcher/map-data-gateway
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
